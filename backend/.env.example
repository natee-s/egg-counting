# Copy to backend/.env. Paths are relative to the project root.
# video = actual MP4 playback (no counting); real = trained AI; demo = simulation.
EGG_MODE=real
EGG_SOURCE="Eggs On A Conveyor Stock Video.mp4"
EGG_SEG_MODEL=models/candidates/kaggle_egg_yolo11n_openvino_model
EGG_CLS_MODEL=models/egg_cls_openvino_model
EGG_DB=data/events.sqlite3
EGG_IMAGE_SIZE=640
EGG_CLS_IMAGE_SIZE=224
EGG_CPU_THREADS=2
# x = vertical line, y = horizontal; direction +1 = right/down, -1 = left/up.
# LINE_POINTS overrides axis/position, following the user's orange guide.
EGG_LINE_AXIS=x
EGG_LINE_POSITION=0.55
EGG_DIRECTION=1
EGG_LINE_POINTS=0.332:0.146,0.395:0.264,0.459:0.382,0.523:0.501,0.588:0.619,0.652:0.737,0.717:0.856,0.795:0.985
EGG_EGG_LABELS=egg
EGG_MODEL_NAME=Kaggle Egg Detection YOLO11n
EGG_DEFECT_ENABLED=0
EGG_START_PAUSED=1
EGG_HYSTERESIS_PX=10
EGG_ARM_FRAMES=2
EGG_TRACK_BUFFER=45
# Recovery uses motion + size and only a unique, one-to-one candidate.
EGG_RECOVER_FRAMES=12
EGG_RECOVER_DISTANCE_PX=24
EGG_MAX_CROSS_GAP=45
EGG_STREAM_FPS=25
EGG_JPEG_QUALITY=85
EGG_MAX_WIDTH=960
EGG_EGG_LABEL=egg
EGG_GOOD_LABELS=good,normal
EGG_DEFECT_LABELS=defect,cracked,crack,dirty,dirt
EGG_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Preserve low-confidence detections for ByteTrack recovery. Do not raise
# DETECTION_CONF above TRACK_LOW_THRESH or those rescue observations are lost.
EGG_DETECTION_CONF=0.10
EGG_DETECTION_IOU=0.65
EGG_MAX_DETECTIONS=300
EGG_TRACK_HIGH_THRESH=0.25
EGG_TRACK_LOW_THRESH=0.10
EGG_NEW_TRACK_THRESH=0.30
EGG_MATCH_THRESH=0.80
EGG_FUSE_SCORE=0
